# Optional: URL that accepts the Contact form submission as JSON via POST.
# Body: { "name": "...", "contact": "...", "message": "...", "source": "...", "submittedAt": "ISO-8601" }
# The form only reports "Message sent" when this endpoint answers with a 2xx status.
# Leave unset to keep the default "prepare for WhatsApp / copy" behaviour (nothing is transmitted).
VITE_CONTACT_ENDPOINT=
